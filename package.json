{
  "name": "event-driven-orders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "tsx watch src/processes/api.ts",
    "start:api": "tsx src/processes/api.ts",
    "start:consumer": "tsx src/processes/payment-consumer.ts",
    "start:dispatcher": "tsx src/processes/outbox-dispatcher.ts",
    "start:worker": "tsx src/processes/notification-worker.ts",
    "start:all": "concurrently -k -n api,consumer,dispatcher,worker 'npm run start:api' 'npm run start:consumer' 'npm run start:dispatcher' 'npm run start:worker'",
    "demo": "tsx src/cli/demo.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/integration/**",
    "test:integration": "vitest run test/integration --testTimeout=30000",
    "test:watch": "vitest"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "pino": "^9.13.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^22.18.10",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
